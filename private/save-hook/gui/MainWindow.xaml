<Window x:Class="HwpSaveHook.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="한글 HWP 저장 런처" Width="660" MinWidth="550" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#F3F5F8"
        FontFamily="Malgun Gothic" FontSize="14" Foreground="#152840" Language="ko-KR"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#152840" />
        <SolidColorBrush x:Key="Muted" Color="#465970" />
        <SolidColorBrush x:Key="Blue" Color="#164FBB" />
        <Style x:Key="LauncherButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="#BCC9D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#6996DA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#516378" />
                                <Setter TargetName="Surface" Property="Background" Value="#E5EAF1" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#E5EAF1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="69" Height="32" Background="#52657F" CornerRadius="16">
                            <Grid Margin="4">
                                <Ellipse x:Name="Thumb" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" />
                                <TextBlock x:Name="State" Text="OFF" Foreground="White" Margin="0,0,6,0"
                                           FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Blue}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="State" Property="Text" Value="ON" />
                                <Setter TargetName="State" Property="HorizontalAlignment" Value="Left" />
                                <Setter TargetName="State" Property="Margin" Value="8,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel>
        <Border Background="#132B4B" Padding="29,25">
            <StackPanel>
                <TextBlock Text="한글 HWP 저장 런처" Foreground="White" FontWeight="Bold" FontSize="29" />
                <TextBlock Text="다른 이름으로 저장하거나 기존 문서를 저장할 때 HWP 형식을 유지합니다."
                           Foreground="#DEE9FA" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" Foreground="#A9BEDD" Margin="0,6,0,0" FontSize="12" />
            </StackPanel>
        </Border>
        <StackPanel Margin="28,23,28,25">
            <Border Background="White" BorderBrush="#D9E1EB" BorderThickness="1" CornerRadius="12" Padding="19">
                <StackPanel>
                    <TextBlock Text="한글 실행 파일" FontWeight="Bold" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HwpPath" AutomationProperties.Name="한글 실행 파일 경로"
                                 IsReadOnly="True" VerticalContentAlignment="Center" Padding="9,5"
                                 BorderBrush="#D2DCE8" Background="#F7F9FC" Foreground="{StaticResource Ink}"
                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="찾아보기…" Click="Browse_Click"
                                Style="{StaticResource LauncherButton}" Margin="9,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="BuildStatus" Foreground="{StaticResource Muted}" Margin="0,11,0,0"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D9E1EB" BorderThickness="1" CornerRadius="12"
                    Padding="19,14" Margin="0,12,0,0">
                <DockPanel LastChildFill="True">
                    <ToggleButton x:Name="ModeSwitch" DockPanel.Dock="Right" Margin="12,0,0,0"
                                  Style="{StaticResource SwitchToggle}"
                                  AutomationProperties.Name="HWP 저장 유지" />
                    <StackPanel>
                        <TextBlock Text="HWP 저장 유지" FontWeight="Bold" />
                        <TextBlock Text="바로가기나 문서 더블클릭 실행에도 이 설정이 적용됩니다." Foreground="{StaticResource Muted}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Background="White" BorderBrush="#D9E1EB" BorderThickness="1" CornerRadius="12"
                    Padding="19,14" Margin="0,12,0,0">
                <DockPanel LastChildFill="True">
                    <ToggleButton x:Name="CompatSwitch" DockPanel.Dock="Right" Margin="12,0,0,0"
                                  Style="{StaticResource SwitchToggle}"
                                  AutomationProperties.Name="검증되지 않은 한글 버전에도 시도" />
                    <StackPanel>
                        <TextBlock Text="검증되지 않은 한글 버전에도 시도 (실험)" FontWeight="Bold" />
                        <TextBlock Text="한글 2018·2020·2024 등에서 저장 형식 변환 코드 구조가 같을 때만 적용합니다. 중요한 문서는 먼저 백업하고 저장 형식을 확인하세요."
                                   Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Background="White" BorderBrush="#D9E1EB" BorderThickness="1" CornerRadius="12"
                    Padding="19,15" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="런처 없이 바로 실행 (관리자 권한 불필요)" FontWeight="Bold" />
                    <DockPanel LastChildFill="True" Margin="0,12,0,0">
                        <Button x:Name="ShortcutButton" DockPanel.Dock="Right" Margin="12,0,0,0"
                                Content="만들기" Click="Shortcut_Click" Style="{StaticResource LauncherButton}"
                                MinWidth="105" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="바탕화면 바로가기" FontWeight="SemiBold" />
                            <TextBlock x:Name="ShortcutStatus" Foreground="{StaticResource Muted}"
                                       Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12.5" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel LastChildFill="True" Margin="0,12,0,0">
                        <ToggleButton x:Name="AssocSwitch" DockPanel.Dock="Right" Margin="12,0,0,0"
                                      Style="{StaticResource SwitchToggle}"
                                      AutomationProperties.Name=".hwp 문서 더블클릭 자동 적용" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text=".hwp 문서 더블클릭 자동 적용" FontWeight="SemiBold" />
                            <TextBlock x:Name="AssocStatus" Foreground="{StaticResource Muted}"
                                       Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12.5" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                <Button x:Name="LaunchButton" Content="한글 열기" Click="Launch_Click"
                        IsEnabled="False" Style="{StaticResource LauncherButton}" Background="{StaticResource Blue}"
                        BorderBrush="{StaticResource Blue}" Foreground="White" FontWeight="Bold" />
                <Button x:Name="ScanButton" Content="다시 찾기" Click="Scan_Click"
                        Style="{StaticResource LauncherButton}" Margin="9,0,0,0" />
                <Button x:Name="UpdateButton" Content="업데이트 확인" Click="Update_Click"
                        Style="{StaticResource LauncherButton}" Margin="9,0,0,0" />
            </StackPanel>
            <Border Background="#E9EFF8" CornerRadius="8" Padding="13" Margin="0,16,0,0">
                <TextBlock x:Name="ActivityStatus" Foreground="{StaticResource Ink}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Button x:Name="LogButton" Content="실행 로그 열기" Click="Log_Click"
                    Style="{StaticResource LauncherButton}" Margin="0,12,0,0"
                    Visibility="Collapsed" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
</Window>
